# Caddy running in Docker. Use with compose.docker-caddy.yml.
# Both containers must share a Docker network (CADDY_NETWORK in .env, default "caddy").
# Merge into your existing Caddyfile, then reload Caddy:
#   docker exec <caddy-container> caddy reload --config /etc/caddy/Caddyfile

# --- Global options: put this block at the very top, or add `on_demand_tls`
# --- to the global block you already have.
{
	# Before obtaining a certificate for a hostname, Caddy asks the app whether
	# that hostname is the platform itself or an existing campaign.
	# "wedding" is the container name set in compose.yml.
	on_demand_tls {
		ask http://wedding:3000/api/tls-check
	}
}

# The platform address and every campaign subdomain under it.
wedding-example.duckdns.org, *.wedding-example.duckdns.org {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# No `log` directive on purpose: invitation URLs contain the guest's token.

	reverse_proxy wedding:3000
}
