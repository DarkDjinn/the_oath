# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# The platform's own address, no trailing slash. The owner panel lives at <SITE_URL>/admin.
SITE_URL=https://wedding-example.duckdns.org

# Each campaign is served at <slug>.<BASE_DOMAIN>. Normally the host part of SITE_URL.
# Leave empty to serve campaigns at <SITE_URL>/w/<slug> instead (no subdomains).
# Local development: BASE_DOMAIN=localhost:3000
BASE_DOMAIN=wedding-example.duckdns.org

# Secret that invitation links are derived from. At least 32 random characters.
# Generate:  openssl rand -base64 48
# Keep it safe and stable: changing it invalidates every link you have sent.
TOKEN_SECRET=

# Owner password (sign-in name: admin), stored only as a scrypt hash.
# Generate the whole line:  npm run hash-password      (or: node scripts/hash-password.mjs)
ADMIN_PASSWORD_HASH=

# --- Docker Compose ---------------------------------------------------------

# How your existing Caddy reaches the app. Use ONE of these.
# Caddy installed on the host (app published on 127.0.0.1 only):
COMPOSE_FILE=compose.yml:compose.host-caddy.yml
# Caddy running in Docker on a shared network (no published ports):
# COMPOSE_FILE=compose.yml:compose.docker-caddy.yml

# Host loopback port (host-Caddy setup only).
APP_PORT=3000
# Name of the Docker network Caddy is on (Docker-Caddy setup only).
CADDY_NETWORK=caddy

# --- Optional (local development / running without Docker) -------------------

# Where the SQLite database and photos live. Docker sets these to /data/...
# DATABASE_PATH=./data/wedding.db
# PHOTOS_DIR=./data/photos

# Only for trying a production build over plain http on a LAN address. Leave unset in production.
# COOKIE_SECURE=false

# --- Automatic WhatsApp sending (optional) -----------------------------------
# Pace and daily limit per linked account. The defaults are deliberately slow.
# WHATSAPP_MIN_GAP_MS=20000
# WHATSAPP_MAX_GAP_MS=40000
# WHATSAPP_DAILY_CAP=150
